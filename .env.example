# Copy thành .env để ghi đè giá trị mặc định trong docker-compose.yml
GATEWAY_PORT=8080
EUREKA_PORT=8761
MSSQL_SA_PASSWORD=Dangnam@2024
ORACLE_PASSWORD=oracle
ORACLE_HR_PASSWORD=hr
MYSQL_ROOT_PASSWORD=dangnam
# Tài khoản ADMIN tạo sẵn ở auth-service
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@123
# Origin frontend được gọi API (phân tách bằng dấu phẩy)
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Khoá ký JWT (để trống = khoá tạm, chỉ dùng dev)
JWT_PRIVATE_KEY_LOCATION=
JWT_PUBLIC_KEY_LOCATION=
