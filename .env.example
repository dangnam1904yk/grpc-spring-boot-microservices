# Copy thành .env để ghi đè giá trị mặc định trong docker-compose.yml
GATEWAY_PORT=8080
EUREKA_PORT=8761
MSSQL_SA_PASSWORD=Dangnam@2024
ORACLE_PASSWORD=oracle
ORACLE_HR_PASSWORD=hr
MYSQL_ROOT_PASSWORD=dangnam
# Keycloak: port trên máy host (cũng là issuer của token), tài khoản console quản trị
KEYCLOAK_PORT=8180
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
# Secret của client auth-service (Admin API). Chỉ có tác dụng lúc realm được import lần đầu
KEYCLOAK_CLIENT_SECRET=dev-auth-service-secret
# Port Redis trên máy host (chỉ docker-compose.db.yml)
REDIS_PORT=16379
# Mật khẩu của tài khoản admin@example.com trong realm (chỉ có tác dụng lúc import lần đầu)
ADMIN_PASSWORD=Admin@123
# Origin frontend được gọi API (phân tách bằng dấu phẩy)
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Đường gửi audit log: kafka (mặc định) hoặc grpc (dự phòng, gọi thẳng audit-service)
AUDIT_TRANSPORT=kafka
# Khoá cho đường grpc dự phòng (production: đổi thành chuỗi ngẫu nhiên dài)
AUDIT_KEY=dev-audit-key
