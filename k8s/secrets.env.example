# Copy thành secrets.env (không commit) rồi đổi toàn bộ giá trị
MYSQL_ROOT_PASSWORD=change-me-mysql
# SQL Server bắt buộc mật khẩu đủ mạnh (hoa, thường, số, ký tự đặc biệt)
MSSQL_SA_PASSWORD=Change-Me@2024
ORACLE_PASSWORD=change-me-oracle
ORACLE_HR_PASSWORD=change-me-hr
# Tài khoản ADMIN tạo sẵn ở auth-service
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Change-Me@123
# Khoá cho đường gửi audit log dự phòng qua gRPC: chuỗi ngẫu nhiên dài
AUDIT_KEY=change-me-to-a-long-random-string
